@model CustomerHoSoViewModel
@{
    ViewData["Title"] = "Hồ sơ";
    Layout = "_CustomerLayout";
}

<div class="topbar">
    <h2>Hồ sơ của tôi</h2>
</div>
@if (TempData["ThongBao"] != null) { <div class="alert-success mb-3">@TempData["ThongBao"]</div> }
<div class="card mb-3" style="max-width:480px; display:flex; gap:14px; align-items:center;">
    @if (!string.IsNullOrEmpty((string?)ViewBag.AnhDaiDien)) { <img src="@ViewBag.AnhDaiDien" alt="avatar" style="width:64px;height:64px;border-radius:50%;object-fit:cover;" /> } else { <div style="font-size:40px;">👤</div> }
    <div style="font-size:13.5px;">
        Trạng thái tài khoản: <b>@ViewBag.TrangThai</b><br />
        Email: @((bool)ViewBag.EmailXt ? "✅ đã xác thực" : "chưa xác thực") · SĐT: @((bool)ViewBag.SdtXt ? "✅ đã xác thực" : "chưa xác thực")<br />
        @if (ViewBag.DongY != null) { <span class="text-muted">Đã đồng ý điều khoản lúc @(((DateTime)ViewBag.DongY).ToString("dd/MM/yyyy"))</span> }
        <div><a asp-controller="BaoMat" asp-action="Index">Đổi ảnh, xác thực OTP, thiết bị đăng nhập, xóa tài khoản →</a></div>
    </div>
</div>
<p><a asp-controller="CustomerDiaChi" asp-action="Index">📍 Quản lý sổ địa chỉ giao hàng</a> · <a asp-controller="CustomerAuth" asp-action="DieuKhoan">Điều khoản &amp; chính sách</a></p>

<div class="card" style="max-width:480px;">
    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="HoTen">Họ tên</label>
            <input asp-for="HoTen" class="form-control" />
            <span asp-validation-for="HoTen" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="SDT">Số điện thoại</label>
            <input asp-for="SDT" class="form-control" />
            <span asp-validation-for="SDT" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="DiaChiGiaoHang">Địa chỉ giao hàng mặc định</label>
            <textarea asp-for="DiaChiGiaoHang" class="form-control"></textarea>
        </div>

        <hr style="border-color:var(--border); margin:20px 0;" />
        <p class="text-muted" style="font-size:13px;">Đổi mật khẩu (bỏ trống nếu không muốn đổi)</p>

        <div class="form-group">
            <label asp-for="MatKhauMoi">Mật khẩu mới</label>
            <input asp-for="MatKhauMoi" type="password" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="XacNhanMatKhauMoi">Xác nhận mật khẩu mới</label>
            <input asp-for="XacNhanMatKhauMoi" type="password" class="form-control" />
            <span asp-validation-for="XacNhanMatKhauMoi" class="field-validation-error"></span>
        </div>

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    </form>
</div>
