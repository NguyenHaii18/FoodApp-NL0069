@model DonHang
@{
    ViewData["Title"] = $"Đơn #{Model.MaDonHang}";
    Layout = "_CustomerLayout";
}

<div class="topbar">
    <h2>Đơn hàng #@Model.MaDonHang</h2>
</div>

@{
    var cacBuoc = new[] { ("ChoXacNhan", "Chờ xác nhận"), ("DaXacNhan", "Đã xác nhận"), ("DangGiao", "Đang giao"), ("DaGiao", "Hoàn thành") };
    var viTri = Array.FindIndex(cacBuoc, b => b.Item1 == Model.TrangThai);
    var taiXe = Model.GiaoHang?.TaiXe;
}

@if (Model.TrangThai == "DaHuy")
{
    <div class="alert-danger mb-3">Đơn hàng này đã bị hủy.@if (!string.IsNullOrWhiteSpace(Model.LyDoTuChoi)) { <text> Lý do: <b>@Model.LyDoTuChoi</b></text> }</div>
}
else
{
    <div class="card mb-3">
        <ol class="order-steps">
            @for (var i = 0; i < cacBuoc.Length; i++)
            {
                <li class="@(i < viTri ? "done" : i == viTri ? "current" : "")">
                    <span class="dot">@(i < viTri ? "✓" : (i + 1).ToString())</span>
                    <span class="lbl">@cacBuoc[i].Item2</span>
                </li>
            }
        </ol>
        @if (Model.TrangThai == "ChoXacNhan")
        {
            <p class="text-muted" style="text-align:center; margin:10px 0 0;">Đang chờ gian hàng xác nhận đơn.</p>
        }
        else if (Model.TrangThai == "DaXacNhan")
        {
            <p class="text-muted" style="text-align:center; margin:10px 0 0;">
                @(Model.MaTaiXe != null ? "Tài xế đã nhận đơn và đang đến gian hàng lấy món." : "Gian hàng đang chuẩn bị món, đang chờ tài xế nhận đơn.")
            </p>
        }
        else if (Model.TrangThai == "DangGiao")
        {
            <p class="text-muted" style="text-align:center; margin:10px 0 0;">
                @(Model.GiaoHang?.TrangThai == "DaNhan" ? "Tài xế đang đến gian hàng lấy món." : "Tài xế đang giao món đến bạn.")
            </p>
            <div id="viTriTaiXe" class="text-muted" style="text-align:center; margin-top:6px; font-size:13px;"></div>
            <script>
            (function(){
                var el=document.getElementById('viTriTaiXe');
                function tai(){
                    fetch('@Url.Action("ViTriTaiXe", "CustomerOrder", new { id = Model.MaDonHang })',{credentials:'same-origin'})
                      .then(function(r){return r.ok?r.json():null;})
                      .then(function(d){
                        if(!d||!d.coViTri){el.textContent='';return;}
                        el.innerHTML='📍 Vị trí tài xế cập nhật '+d.giayTruoc+'s trước'+(d.cu?' (tín hiệu yếu)':'')+
                          ' — <a target="_blank" rel="noopener" href="https://www.google.com/maps?q='+d.lat+','+d.lng+'">xem trên bản đồ</a>';
                      }).catch(function(){});
                }
                tai(); setInterval(tai,10000);
            })();
            </script>
            @if (!string.IsNullOrEmpty(Model.MaXacNhanGiao) && Model.GiaoHang?.TrangThai == "DangGiao")
            {
                <div style="text-align:center; margin-top:10px;">Mã xác nhận nhận hàng: <b style="font-size:26px; letter-spacing:6px;">@Model.MaXacNhanGiao</b><br /><small class="text-muted">Chỉ đọc mã này cho tài xế khi bạn đã nhận đủ món. Không gửi mã cho ai khác.</small></div>
            }
        }
    </div>
}

@if (TempData["ThongBao"] != null) { <div class="alert-success mb-3">@TempData["ThongBao"]</div> }
@if (TempData["LoiThongBao"] != null) { <div class="alert-danger mb-3">@TempData["LoiThongBao"]</div> }
@if (Model.TrangThai is "ChoXacNhan" or "DaXacNhan" or "DangGiao")
{
    var phut = Model.TrangThai == "DangGiao" ? 20 : Model.TrangThai == "DaXacNhan" ? 35 : 45;
    <p class="text-muted" style="margin:0 0 12px;">⏱️ Dự kiến giao khoảng <b>@Model.NgayDat.AddMinutes(phut + 10).ToString("HH:mm")</b> (ước tính theo trạng thái hiện tại).</p>
}

@if (taiXe != null)
{
    <div class="card mb-3 driver-box">
        <div class="driver-avatar">🛵</div>
        <div style="flex:1;">
            <div><strong>@taiXe.HoTen</strong></div>
            <div class="text-muted" style="font-size:13px;">
                @(string.IsNullOrWhiteSpace(taiXe.PhuongTien) ? "Xe máy" : taiXe.PhuongTien)
                @if (!string.IsNullOrWhiteSpace(taiXe.BienSo)) { <text> · Biển số @taiXe.BienSo</text> }
            </div>
        </div>
        <a href="tel:@taiXe.SDT" class="btn btn-outline">📞 @taiXe.SDT</a>
    </div>
}

<div class="grid-2">
    <div class="card">
        <h3 style="margin-top:0;">@Model.GianHang?.TenCuaHang</h3>
        <table class="data-table">
            <thead><tr><th>Món</th><th>SL</th><th>Thành tiền</th></tr></thead>
            <tbody>
                @foreach (var ct in Model.ChiTiets)
                {
                    <tr><td>@ct.MonAn?.TenMon@if (!string.IsNullOrWhiteSpace(ct.TuyChon)) { <div class="text-muted" style="font-size:12px;">@ct.TuyChon</div> }@if (!string.IsNullOrWhiteSpace(ct.GhiChu)) { <div class="text-muted" style="font-size:12px;">📝 @ct.GhiChu</div> }</td><td>@ct.SoLuong</td><td>@ct.ThanhTien.ToString("N0")đ</td></tr>
                }
            </tbody>
        </table>
        @if (Model.PhiGiaoHang > 0)
        {
            <div style="text-align:right; margin-top:12px; font-size:13.5px;">Phí giao hàng: @Model.PhiGiaoHang.ToString("N0")đ</div>
        }
        <div style="text-align:right; margin-top:6px; font-weight:700; font-size:16px;">
            Tổng cộng: @Model.TongTien.ToString("N0")đ
        </div>
    </div>

    <div class="card">
        <h3 style="margin-top:0;">Trạng thái</h3>
        <p>@await Html.PartialAsync("~/Views/Dashboard/_BadgeTrangThaiDonHang.cshtml", Model.TrangThai)</p>
        <p><strong>Ngày đặt:</strong> @Model.NgayDat.ToString("HH:mm dd/MM/yyyy")</p>
        <p><strong>Giao đến:</strong> @Model.DiaChiGiaoHang</p>
        @if (!string.IsNullOrEmpty(Model.GhiChu))
        {
            <p><strong>Ghi chú:</strong> @Model.GhiChu</p>
        }
        @if (Model.ThanhToan != null)
        {
            <p><strong>Thanh toán:</strong> @Model.ThanhToan.HinhThuc — @Model.ThanhToan.TrangThai@if (!string.IsNullOrEmpty(Model.ThanhToan.MaGiaoDich)) { <text> · Mã GD @Model.ThanhToan.MaGiaoDich</text> }</p>
        }

        @if (Model.TrangThai == "ChoXacNhan")
        {
            <form asp-action="HuyDon" asp-route-id="@Model.MaDonHang" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger" onclick="return confirm('Huỷ đơn hàng này?')">Huỷ đơn</button>
            </form>
        }

        @if (Model.TrangThai == "DaGiao")
        {
            <a asp-action="DanhGia" asp-route-id="@Model.MaDonHang" class="btn btn-accent mt-3">Đánh giá đơn hàng</a>
        }
        @if (Model.TrangThai is "DaGiao" or "DaHuy")
        {
            <form asp-action="MuaLai" asp-route-id="@Model.MaDonHang" method="post" style="display:inline-block;" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">🔁 Mua lại</button>
            </form>
        }
        @if (Model.ThanhToan?.TrangThai == "DaThanhToan")
        {
            <form asp-action="YeuCauHoanTien" asp-route-id="@Model.MaDonHang" method="post" class="mt-3" onsubmit="var l=prompt('Lý do yêu cầu hoàn tiền?'); if(!l) return false; this.lyDo.value=l; return true;">
                @Html.AntiForgeryToken()<input type="hidden" name="lyDo" />
                <button class="btn btn-outline btn-sm">💸 Yêu cầu hoàn tiền</button>
            </form>
        }
        @foreach (var y in (List<YeuCauHoanTien>)ViewBag.HoanTien)
        {
            <p class="text-muted" style="font-size:12.5px; margin:6px 0 0;">Hoàn tiền #@y.MaYeuCau: <b>@(y.TrangThai == "ChoDuyet" ? "đang chờ duyệt" : y.TrangThai == "DaDuyet" ? "đã duyệt" : "bị từ chối")</b>@if (!string.IsNullOrEmpty(y.KetQua)) { <text> — @y.KetQua</text> }</p>
        }
        <a asp-action="BienNhan" asp-route-id="@Model.MaDonHang" class="btn btn-outline mt-3">🧾 Biên nhận</a>
        <p class="text-muted" style="font-size:12.5px; margin-top:10px;">Cần hỗ trợ gấp? <a asp-controller="CustomerHoTro" asp-action="Index">Liên hệ hỗ trợ</a>@if (!string.IsNullOrWhiteSpace(Model.GianHang?.SDT)) { <text> hoặc gọi quán <a href="tel:@Model.GianHang!.SDT">@Model.GianHang.SDT</a></text> }</p>

        <div class="mt-3">
            <a asp-controller="CustomerPhanHoi" asp-action="Index" asp-route-donHang="@Model.MaDonHang" style="font-size:13px;">💬 Gửi phản hồi / khiếu nại về đơn này</a>
        </div>
    </div>
</div>
