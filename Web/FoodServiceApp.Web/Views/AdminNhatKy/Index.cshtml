@model List<FoodServiceApp.Web.Models.Entities.NhatKyHeThong>
@{
    ViewData["Title"] = "Nhật ký thao tác";
    Layout = "_AdminLayout";
    var ten = (Dictionary<int, string>)ViewBag.Ten;
}
<div class="topbar"><h2>Nhật ký thao tác & đăng nhập</h2></div>
<div class="card mb-3">
    <form method="get" style="display:flex; gap:8px; flex-wrap:wrap;">
        <select name="nguon" class="form-control" style="max-width:160px;">
            <option value="">Mọi nguồn</option>
            @foreach (var n in new[] { "Auth", "ThaoTac", "Otp", "TaiKhoan" }) { <option value="@n" selected="@((string?)ViewBag.Nguon == n)">@n</option> }
        </select>
        <select name="mucDo" class="form-control" style="max-width:140px;">
            <option value="">Mọi mức</option>
            @foreach (var n in new[] { "Info", "Warn", "Error" }) { <option value="@n" selected="@((string?)ViewBag.MucDo == n)">@n</option> }
        </select>
        <input name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tìm nội dung / IP..." style="flex:1; min-width:160px;" />
        <button class="btn btn-primary">Lọc</button>
    </form>
</div>
<div class="card">
    @if (!Model.Any()) { <div class="empty-state">Không có bản ghi.</div> }
    else
    {
        <table class="data-table">
            <thead><tr><th>Thời gian</th><th>Mức</th><th>Nguồn</th><th>Nội dung</th><th>Tài khoản</th><th>IP</th><th>HTTP</th></tr></thead>
            <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td>@n.ThoiGian.ToString("dd/MM HH:mm:ss")</td>
                    <td><span class="badge @(n.MucDo == "Error" ? "badge-danger" : n.MucDo == "Warn" ? "badge-warning" : "badge-success")">@n.MucDo</span></td>
                    <td>@n.Nguon</td>
                    <td>@n.ThongDiep</td>
                    <td>@(n.MaTK != null && ten.ContainsKey(n.MaTK.Value) ? ten[n.MaTK.Value] : (n.MaTK?.ToString() ?? "—"))</td>
                    <td>@n.DiaChiIP</td>
                    <td>@n.PhuongThuc @n.MaTrangThai</td>
                </tr>
            }
            </tbody>
        </table>
        <div style="margin-top:12px; display:flex; gap:8px; align-items:center;">
            @if ((int)ViewBag.Trang > 1) { <a class="btn btn-sm btn-outline" asp-route-trang="@((int)ViewBag.Trang - 1)" asp-route-nguon="@ViewBag.Nguon" asp-route-mucDo="@ViewBag.MucDo" asp-route-tuKhoa="@ViewBag.TuKhoa">← Trước</a> }
            <span>Trang @ViewBag.Trang / @ViewBag.TongTrang</span>
            @if ((int)ViewBag.Trang < (int)ViewBag.TongTrang) { <a class="btn btn-sm btn-outline" asp-route-trang="@((int)ViewBag.Trang + 1)" asp-route-nguon="@ViewBag.Nguon" asp-route-mucDo="@ViewBag.MucDo" asp-route-tuKhoa="@ViewBag.TuKhoa">Sau →</a> }
        </div>
    }
</div>
