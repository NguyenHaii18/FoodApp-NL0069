@model List<DanhGia>
@{
    ViewData["Title"] = "Tất cả đánh giá";
    Layout = "_AdminLayout";
    var quan = (Dictionary<int, string>)ViewBag.Quan; var khach = (Dictionary<int, string>)ViewBag.Khach;
}
<div class="topbar"><h2>⭐ Đánh giá</h2></div>
<div class="order-tabs"><a asp-action="Index" asp-route-tab="bao-cao">Chờ xử lý</a><a asp-action="Index" asp-route-tab="tat-ca" class="active">Tất cả đánh giá</a></div>
<form method="get" class="card mb-3" style="display:flex; gap:8px; align-items:end;"><input type="hidden" name="tab" value="tat-ca" />
    <div><label>Số sao</label><select name="sao" class="form-control"><option value="">Tất cả</option>@for (var i = 1; i <= 5; i++) { <option value="@i" selected="@((int?)ViewBag.Sao == i)">@i ⭐</option> }</select></div>
    <button class="btn btn-primary">Lọc</button></form>
<div class="card"><table class="data-table"><thead><tr><th>Ngày</th><th>Gian hàng</th><th>Khách</th><th>Sao</th><th>Nội dung</th><th>Trạng thái</th></tr></thead><tbody>
@foreach (var d in Model)
{
    <tr><td>@d.NgayDanhGia.ToString("dd/MM/yy")</td><td>@(quan.TryGetValue(d.MaGianHang, out var q) ? q : "")</td><td>@(khach.TryGetValue(d.MaKH, out var k) ? k : "")</td>
    <td>@d.SoSao@if (d.SoSaoGiaoHang != null) { <span class="text-muted"> / TX @d.SoSaoGiaoHang</span> }</td><td>@d.NoiDung</td>
    <td>@if (d.DaAn) { <span class="badge badge-danger">Đã ẩn</span><div class="text-muted" style="font-size:11px;">@d.LyDoAn</div><form asp-action="Hien" asp-route-maDanhGia="@d.MaDanhGia" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline btn-sm">Hiện lại</button></form> }
        else { <form asp-action="An" asp-route-maDanhGia="@d.MaDanhGia" method="post" style="display:flex; gap:4px;" onsubmit="var l=prompt('Lý do ẩn?'); if(!l) return false; this.lyDo.value=l; return true;">@Html.AntiForgeryToken()<input type="hidden" name="lyDo" /><button class="btn btn-danger btn-sm">Ẩn</button></form> }</td></tr>
}
</tbody></table></div>
