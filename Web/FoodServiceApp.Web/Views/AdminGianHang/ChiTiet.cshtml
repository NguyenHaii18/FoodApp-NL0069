@model GianHang
@{
    ViewData["Title"] = Model.TenCuaHang;
    Layout = "_AdminLayout";
    var taiKhoan = (TaiKhoan)ViewBag.TaiKhoan;
}

<div class="topbar">
    <h2>@Model.TenCuaHang</h2>
    <a asp-action="Index" class="btn btn-outline btn-sm">← Quay lại danh sách</a>
</div>

<div class="grid-4 mb-3">
    <div class="stat-card">
        <div class="label">Tổng doanh thu</div>
        <div class="value">@(((decimal)ViewBag.TongDoanhThu).ToString("N0"))đ</div>
    </div>
    <div class="stat-card" style="background:#1E1E1E;">
        <div class="label">Đơn hoàn thành</div>
        <div class="value">@ViewBag.TongDonHoanThanh</div>
    </div>
    <div class="stat-card" style="background: var(--accent);">
        <div class="label">Số món ăn</div>
        <div class="value">@ViewBag.SoMonAn</div>
    </div>
    <div class="stat-card" style="background: var(--success);">
        <div class="label">Đánh giá TB</div>
        <div class="value">⭐ @(((double)ViewBag.DiemTrungBinh).ToString("0.0")) (@ViewBag.SoDanhGia)</div>
    </div>
</div>

<div class="grid-2">
    <div class="card">
        <h3 style="margin-top:0;">Thông tin cửa hàng</h3>
        <p><strong>Địa chỉ:</strong> @Model.DiaChi</p>
        <p><strong>SĐT:</strong> @Model.SDT</p>
        <p><strong>Ngày đăng ký:</strong> @Model.NgayDangKy.ToString("dd/MM/yyyy")</p>
        <p><strong>Mô tả:</strong> @(Model.MoTa ?? "—")</p>
        <p><strong>Giấy phép KD:</strong> @if (!string.IsNullOrEmpty(Model.GiayPhepKinhDoanh)) { <a href="@Model.GiayPhepKinhDoanh" target="_blank">Xem</a> } else { <text>—</text> }
           · <strong>ATTP:</strong> @if (!string.IsNullOrEmpty(Model.GiayChungNhanATTP)) { <a href="@Model.GiayChungNhanATTP" target="_blank">Xem</a> } else { <text>—</text> }</p>
        @if (!string.IsNullOrWhiteSpace(Model.LyDoTuChoi)) { <p><strong>Lý do từ chối:</strong> @Model.LyDoTuChoi</p> }
        @if (!string.IsNullOrWhiteSpace(Model.YeuCauBoSung)) { <p><strong>Đã yêu cầu bổ sung:</strong> @Model.YeuCauBoSung</p> }
        <p><a asp-controller="AdminMonAn" asp-action="Index" asp-route-maGianHang="@Model.MaGianHang">🍜 Xem & kiểm duyệt món ăn</a> · <a asp-controller="AdminDonHang" asp-action="Index" asp-route-q="@Model.TenCuaHang">📦 Đơn của quán</a></p>
    </div>

    <div class="card">
        <h3 style="margin-top:0;">Tài khoản đăng nhập</h3>
        <p><strong>Tên đăng nhập:</strong> @taiKhoan.TenDangNhap</p>
        <p><strong>Trạng thái:</strong>
            @if (taiKhoan.TrangThai) { <span class="badge badge-success">Hoạt động</span> }
            else { <span class="badge badge-danger">Đã khoá</span> }
        </p>
        <form asp-action="DatHoaHong" asp-route-maGianHang="@Model.MaGianHang" method="post" class="mt-3" style="display:flex; gap:8px; align-items:center;">
            @Html.AntiForgeryToken()
            <label style="font-size:13px;">Hoa hồng/phí nền tảng (%)</label>
            <input name="phanTram" type="number" step="0.1" min="0" max="100" class="form-control" style="width:100px;" value="@((Model.TyLeChietKhau * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
            <button class="btn btn-primary btn-sm">Lưu</button>
        </form>
        <form asp-action="ToggleKhoa" asp-route-maTK="@taiKhoan.MaTK" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn @(taiKhoan.TrangThai ? "btn-danger" : "btn-primary")"
                    onclick="return confirm('@(taiKhoan.TrangThai ? "Khoá" : "Mở khoá") tài khoản này?')">
                @(taiKhoan.TrangThai ? "Khoá tài khoản" : "Mở khoá tài khoản")
            </button>
        </form>
    </div>
</div>
