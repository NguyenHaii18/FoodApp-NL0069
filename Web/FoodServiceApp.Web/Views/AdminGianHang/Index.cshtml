@model List<(GianHang GianHang, TaiKhoan TaiKhoan)>
@{
    ViewData["Title"] = "Gian hàng";
    Layout = "_AdminLayout";
}

<div class="topbar">
    <h2>Quản lý gian hàng (đối tác)</h2>
    <a asp-action="ChoDuyet" class="btn btn-accent">
        Chờ duyệt @(((int)ViewBag.SoChoDuyet) > 0 ? $"({ViewBag.SoChoDuyet})" : "")
    </a>
</div>

<div class="card mb-3">
    <form method="get" style="display:flex; gap:8px;">
        <input type="text" name="timKiem" value="@ViewBag.TimKiem" class="form-control" placeholder="Tìm theo tên cửa hàng..." />
        <button type="submit" class="btn btn-primary">Tìm</button>
    </form>
</div>

@if (!Model.Any())
{
    <div class="card"><div class="empty-state">Không tìm thấy gian hàng nào.</div></div>
}
else
{
    <div class="card">
        <table class="data-table">
            <thead><tr><th>Tên cửa hàng</th><th>Địa chỉ</th><th>Ngày đăng ký</th><th>Kinh doanh</th><th>Tài khoản</th><th></th></tr></thead>
            <tbody>
                @foreach (var (gh, tk) in Model)
                {
                    <tr>
                        <td><a asp-action="ChiTiet" asp-route-id="@gh.MaGianHang">@gh.TenCuaHang</a></td>
                        <td>@gh.DiaChi</td>
                        <td>@gh.NgayDangKy.ToString("dd/MM/yyyy")</td>
                        <td>
                            @{
                                var (css, nhan) = gh.TrangThaiKinhDoanh switch
                                {
                                    "DangMo" => ("badge-success", "Đang mở"),
                                    "DongCua" => ("badge-grey", "Đóng cửa"),
                                    _ => ("badge-warning", "Tạm ngưng")
                                };
                            }
                            <span class="badge @css">@nhan</span>
                        </td>
                        <td>
                            @if (tk.TrangThai)
                            {
                                <span class="badge badge-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Đã khoá</span>
                            }
                        </td>
                        <td style="white-space:nowrap;">
                            <a asp-action="ChiTiet" asp-route-id="@gh.MaGianHang" class="btn btn-outline btn-sm">Chi tiết</a>
                            <form asp-action="ToggleKhoa" asp-route-maTK="@tk.MaTK" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(tk.TrangThai ? "btn-danger" : "btn-outline")"
                                        onclick="return confirm('@(tk.TrangThai ? "Khoá" : "Mở khoá") tài khoản \'@gh.TenCuaHang\'?')">
                                    @(tk.TrangThai ? "Khoá" : "Mở khoá")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
