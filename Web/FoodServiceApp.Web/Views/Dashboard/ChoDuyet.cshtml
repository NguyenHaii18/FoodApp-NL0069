
@model GianHang
@{
    ViewData["Title"] = "Trạng thái hồ sơ gian hàng";
}

<div class="card" style="max-width:520px; margin:60px auto; text-align:center;">

    @if (Model.TrangThaiDuyet == "ChuaGuiHoSo")
    {
        <h2>Hoàn thiện hồ sơ gian hàng</h2>
        <p class="text-muted">
            Tài khoản đã được tạo thành công.
            Vui lòng hoàn thiện hồ sơ trước khi gửi xét duyệt.
        </p>
    }
    else if (Model.TrangThaiDuyet == "CanBoSung")
    {
        <h2>Hồ sơ cần bổ sung</h2>
        <p class="text-muted">
            Quản trị viên yêu cầu bổ sung thông tin.
        </p>
        <p>@Model.YeuCauBoSung</p>
    }
    else if (Model.TrangThaiDuyet == "ChoDuyet")
    {
        <h2>Hồ sơ đang chờ duyệt</h2>
        <p class="text-muted">
            Hồ sơ của @Model.TenCuaHang đã được gửi.
            Vui lòng chờ quản trị viên xét duyệt.
        </p>
    }
    else if (Model.TrangThaiDuyet == "TuChoi")
    {
        <h2>Hồ sơ đã bị từ chối</h2>
        <p class="text-muted">
            Lý do: @Model.LyDoTuChoi
        </p>
    }

    @if (TempData["LoiThongBao"] is string loi)
    {
        <p class="text-danger">@loi</p>
    }

    @if (TempData["ThongBao"] is string thongBao)
    {
        <p class="text-success">@thongBao</p>
    }

    @if (Model.TrangThaiDuyet == "ChuaGuiHoSo" ||
         Model.TrangThaiDuyet == "CanBoSung")
    {
        <a asp-controller="HoSo"
           asp-action="Index"
           class="btn btn-outline mt-3">
            Hoàn thiện hồ sơ
        </a>

        <form asp-controller="Dashboard"
              asp-action="GuiHoSoXetDuyet"
              method="post"
              style="margin-top:12px;">
            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-primary">
                Gửi hồ sơ xét duyệt
            </button>
        </form>
    }
    else
    {
        <a asp-controller="HoSo"
           asp-action="Index"
           class="btn btn-outline mt-3">
            Xem hồ sơ
        </a>
    }

    <form asp-controller="Auth"
          asp-action="Logout"
          method="post"
          style="margin-top:16px;">
        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-outline">
            Đăng xuất
        </button>
    </form>
</div>
