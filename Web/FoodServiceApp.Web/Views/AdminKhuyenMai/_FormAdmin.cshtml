@model KhuyenMaiFormViewModel

<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

<div class="form-group">
    <label asp-for="MaCode">Mã khuyến mãi</label>
    <input asp-for="MaCode" class="form-control" placeholder="vd: GIAM20" style="text-transform:uppercase;" />
    <span asp-validation-for="MaCode" class="field-validation-error"></span>
</div>

<div class="form-group">
    <label asp-for="MoTa">Mô tả</label>
    <textarea asp-for="MoTa" class="form-control" placeholder="vd: Giảm 20% cho đơn từ 50.000đ"></textarea>
</div>

<div class="grid-2">
    <div class="form-group">
        <label asp-for="LoaiGiam">Loại giảm</label>
        <select asp-for="LoaiGiam" class="form-control">
            <option value="PhanTram">Giảm theo %</option>
            <option value="SoTien">Giảm số tiền cố định</option>
            <option value="GiamPhiVanChuyen">Giảm phí giao hàng (số tiền tối đa)</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="GiaTriGiam">Giá trị giảm</label>
        <input asp-for="GiaTriGiam" type="number" step="1" class="form-control" placeholder="vd: 20" />
    </div>
</div>

<div class="form-group">
    <label asp-for="DieuKienApDung">Điều kiện áp dụng</label>
    <input asp-for="DieuKienApDung" class="form-control" placeholder="vd: Đơn tối thiểu 50.000đ" />
</div>

<div class="grid-2">
    <div class="form-group">
        <label asp-for="NgayBatDau">Ngày bắt đầu</label>
        <input asp-for="NgayBatDau" type="date" class="form-control" />
        <span asp-validation-for="NgayBatDau" class="field-validation-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="NgayKetThuc">Ngày kết thúc</label>
        <input asp-for="NgayKetThuc" type="date" class="form-control" />
        <span asp-validation-for="NgayKetThuc" class="field-validation-error"></span>
    </div>
</div>

<div class="form-group"><label asp-for="TenChuongTrinh">Tên chương trình</label><input asp-for="TenChuongTrinh" class="form-control" /></div>
<div class="grid-2">
    <div class="form-group"><label asp-for="GiaTriDonToiThieu">Đơn tối thiểu (đ)</label><input asp-for="GiaTriDonToiThieu" type="number" min="0" class="form-control" /></div>
    <div class="form-group"><label asp-for="GiamToiDa">Giảm tối đa (đ, cho loại %)</label><input asp-for="GiamToiDa" type="number" min="0" class="form-control" /></div>
</div>
<div class="grid-2">
    <div class="form-group"><label asp-for="SoLuongToiDa">Tổng số lượt dùng (trống = không giới hạn)</label><input asp-for="SoLuongToiDa" type="number" min="1" class="form-control" /></div>
    <div class="form-group"><label style="display:flex; gap:8px; align-items:center; margin-top:26px;"><input asp-for="MoiKhachMotLan" type="checkbox" style="width:auto;" /> Mỗi khách chỉ dùng 1 lần</label></div>
</div>
<p class="text-muted" style="font-size:12.5px; margin:0 0 6px;">Phạm vi áp dụng (nhập mã số, cách nhau dấu phẩy; để trống = không giới hạn):</p>
<div class="form-group"><label asp-for="DsGianHang">Gian hàng (MaGianHang)</label><input asp-for="DsGianHang" class="form-control" placeholder="vd: 1,2,5" /></div>
<div class="form-group"><label asp-for="DsDanhMuc">Danh mục (MaDanhMuc)</label><input asp-for="DsDanhMuc" class="form-control" /></div>
<div class="form-group"><label asp-for="DsMonAn">Món ăn (MaMonAn)</label><input asp-for="DsMonAn" class="form-control" /></div>

<div class="form-group">
    <label style="display:flex; align-items:center; gap:8px;">
        <input asp-for="TrangThai" type="checkbox" style="width:auto;" />
        Kích hoạt ngay
    </label>
</div>
