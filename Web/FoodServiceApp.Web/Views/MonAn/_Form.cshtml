@model MonAnFormViewModel

<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

<div class="form-group">
    <label asp-for="TenMon">Tên món</label>
    <input asp-for="TenMon" class="form-control" placeholder="vd: Cơm sườn bì chả" />
    <span asp-validation-for="TenMon" class="field-validation-error"></span>
</div>

<div class="form-group">
    <label asp-for="Gia">Giá (đ)</label>
    <input asp-for="Gia" type="number" step="1000" class="form-control" placeholder="45000" />
    <span asp-validation-for="Gia" class="field-validation-error"></span>
</div>

<div class="form-group">
    <label asp-for="GiaVon">Giá vốn/phần (đ)</label>
    <input asp-for="GiaVon" type="number" min="0" step="1000" class="form-control" />
    <span asp-validation-for="GiaVon" class="field-validation-error"></span>
    <span class="text-muted" style="font-size:12px;">Dùng để ước tính lợi nhuận trong báo cáo.</span>
</div>

<div class="form-group">
    <label asp-for="MaDanhMuc">Danh mục</label>
    <select asp-for="MaDanhMuc" class="form-control">
        <option value="0">-- Chọn danh mục có sẵn --</option>
        @foreach (var dm in Model.DanhSachDanhMuc)
        {
            <option value="@dm.MaDanhMuc">@dm.TenDanhMuc</option>
        }
    </select>
</div>

<div class="form-group">
    <label asp-for="TenDanhMucMoi">Hoặc tạo danh mục mới (bỏ trống nếu đã chọn ở trên)</label>
    <input asp-for="TenDanhMucMoi" class="form-control" placeholder="vd: Món thêm" />
    <span asp-validation-for="TenDanhMucMoi" class="field-validation-error"></span>
</div>

<div class="form-group">
    <label asp-for="MoTa">Mô tả</label>
    <textarea asp-for="MoTa" class="form-control" placeholder="Mô tả ngắn về món ăn (không bắt buộc)"></textarea>
</div>

<div class="form-group">
    <label>Ảnh món ăn</label>
    @if (!string.IsNullOrEmpty(Model.HinhAnhHienTai))
    {
        <div class="mb-2">
            <img src="@Model.HinhAnhHienTai" style="width:80px;height:80px;border-radius:10px;object-fit:cover;" />
        </div>
    }
    <input asp-for="AnhMoi" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
    <span class="text-muted" style="font-size:12px;">Bỏ trống nếu không muốn đổi ảnh. Tối đa 5MB.</span>
</div>

<div class="form-group">
    <label asp-for="TinhTrang">Tình trạng bán</label>
    <select asp-for="TinhTrang" class="form-control">
        <option value="ConHang">Còn hàng</option>
        <option value="HetHang">Hết hàng</option>
        <option value="TamNgung">Tạm ngừng bán</option>
    </select>
    <span asp-validation-for="TinhTrang" class="field-validation-error"></span>
</div>

<div class="form-group">
    <label style="display:flex; align-items:center; gap:8px;">
        <input asp-for="ChoGhiChu" type="checkbox" style="width:auto;" />
        Cho phép khách ghi chú cho món
    </label>
</div>

<section class="option-editor">
    <h3>Tùy chọn món ăn</h3>
    <p class="text-muted">Có thể để trống. Khách chọn tối đa một size, nhiều topping và tối đa một mức cay.</p>
    <span asp-validation-for="TuyChon" class="field-validation-error"></span>

    @foreach (var group in new[]
    {
        (Loai: "Size", TieuDe: "Size", Nut: "+ Thêm size", GoiY: "S, M, L"),
        (Loai: "Topping", TieuDe: "Topping", Nut: "+ Thêm topping", GoiY: "Trân châu, Pudding"),
        (Loai: "MucCay", TieuDe: "Mức cay", Nut: "+ Thêm mức cay", GoiY: "Không cay, Cay vừa")
    })
    {
        <div class="option-group">
            <div class="option-group-title">
                <strong>@group.TieuDe</strong>
                <button type="button" class="btn btn-outline btn-sm add-option" data-type="@group.Loai">@group.Nut</button>
            </div>
            <div class="option-table-head"><span>Tên tùy chọn</span><span>Phụ phí (đ)</span><span>Thao tác</span></div>
            <div class="option-rows" data-group="@group.Loai" data-placeholder="@group.GoiY">
                @for (var i = 0; i < Model.TuyChon.Count; i++)
                {
                    var option = Model.TuyChon[i];
                    if (option.Loai != group.Loai) continue;
                    var token = $"existing-{i}";
                    <div class="option-row">
                        <input type="hidden" name="TuyChon.Index" value="@token" />
                        <input type="hidden" name="TuyChon[@token].MaTuyChon" value="@option.MaTuyChon" />
                        <input type="hidden" name="TuyChon[@token].Loai" value="@option.Loai" />
                        <input class="form-control" name="TuyChon[@token].Ten" value="@option.Ten" maxlength="100" placeholder="@group.GoiY" required />
                        <input class="form-control" name="TuyChon[@token].GiaThem" value="@option.GiaThem.ToString("0")" type="number" min="0" max="10000000" step="1000" required />
                        <button type="button" class="btn btn-outline btn-sm remove-option">Xóa</button>
                    </div>
                }
            </div>
        </div>
    }
</section>

<style>
    .option-editor { margin:24px 0; padding:18px; border:1px solid #e5e7eb; border-radius:12px; background:#fafafa; }
    .option-editor h3 { margin:0 0 4px; text-transform:uppercase; font-size:16px; }
    .option-group { margin-top:18px; }
    .option-group-title { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:8px; }
    .option-table-head, .option-row { display:grid; grid-template-columns:minmax(180px, 1fr) minmax(120px, 180px) 80px; gap:8px; align-items:center; }
    .option-table-head { padding:0 4px 6px; color:#6b7280; font-size:12px; }
    .option-row { margin-bottom:8px; }
    @@media (max-width:640px) {
        .option-table-head { display:none; }
        .option-row { grid-template-columns:1fr 120px auto; }
    }
</style>

<script>
    (() => {
        let sequence = @Model.TuyChon.Count;
        const escapeAttribute = value => String(value).replace(/[&<>'"]/g, ch => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
        })[ch]);

        document.querySelectorAll('.add-option').forEach(button => button.addEventListener('click', () => {
            const type = button.dataset.type;
            const container = document.querySelector(`.option-rows[data-group="${type}"]`);
            const token = `new-${Date.now()}-${sequence++}`;
            const placeholder = escapeAttribute(container.dataset.placeholder || 'Tên tùy chọn');
            container.insertAdjacentHTML('beforeend', `
                <div class="option-row">
                    <input type="hidden" name="TuyChon.Index" value="${token}" />
                    <input type="hidden" name="TuyChon[${token}].MaTuyChon" value="0" />
                    <input type="hidden" name="TuyChon[${token}].Loai" value="${type}" />
                    <input class="form-control" name="TuyChon[${token}].Ten" maxlength="100" placeholder="${placeholder}" required />
                    <input class="form-control" name="TuyChon[${token}].GiaThem" value="0" type="number" min="0" max="10000000" step="1000" required />
                    <button type="button" class="btn btn-outline btn-sm remove-option">Xóa</button>
                </div>`);
        }));

        document.addEventListener('click', event => {
            const button = event.target.closest('.remove-option');
            if (button) button.closest('.option-row').remove();
        });
    })();
</script>
