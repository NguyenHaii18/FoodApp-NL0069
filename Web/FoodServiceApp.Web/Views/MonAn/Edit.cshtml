@model MonAnFormViewModel
@{ ViewData["Title"] = "Sửa món ăn"; }

<div class="topbar">
    <h2>Sửa món ăn — @Model.TenMon</h2>
    <a asp-action="Index" class="btn btn-outline btn-sm">← Quay lại</a>
</div>

<div class="card" style="max-width:520px;">
    <form asp-action="Edit" asp-route-id="@Model.MaMonAn" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("_Form", Model)
        <button type="submit" class="btn btn-primary">Cập nhật</button>
    </form>
</div>
