@model DoanhThuViewModel
@{
    ViewData["Title"] = "Báo cáo kinh doanh";
    var labels = Model.DoanhThuTheoNgay.Select(x => x.Ngay.ToString("dd/MM")).ToList();
    var values = Model.DoanhThuTheoNgay.Select(x => x.DoanhThu).ToList();
}
<div class="topbar"><h2>Doanh thu và báo cáo kinh doanh</h2></div>
<div class="card mb-3"><form method="get" style="display:flex;gap:12px;align-items:end;flex-wrap:wrap;">
    <div class="form-group" style="margin:0"><label>Từ ngày</label><input class="form-control" type="date" name="tu" value="@Model.TuNgay.ToString("yyyy-MM-dd")" /></div>
    <div class="form-group" style="margin:0"><label>Đến ngày</label><input class="form-control" type="date" name="den" value="@Model.DenNgay.ToString("yyyy-MM-dd")" /></div>
    <button class="btn btn-primary" type="submit">Xem báo cáo</button>
    <a class="btn btn-outline" asp-action="ExportCsv" asp-route-tu="@Model.TuNgay.ToString("yyyy-MM-dd")" asp-route-den="@Model.DenNgay.ToString("yyyy-MM-dd")">Xuất CSV</a>
</form></div>
<div class="grid-2 mb-3">
    <div class="stat-card"><div class="label">Doanh thu món</div><div class="value">@Model.TongDoanhThu.ToString("N0")đ</div><small>@Model.TongDonHoanThanh đơn hoàn thành</small></div>
    <div class="stat-card" style="background:var(--accent)"><div class="label">Thực nhận sau phí</div><div class="value">@Model.ThucNhan.ToString("N0")đ</div><small>Phí nền tảng @Model.PhiNenTang.ToString("N0")đ</small></div>
    <div class="stat-card"><div class="label">Lợi nhuận ước tính</div><div class="value">@Model.LoiNhuanUocTinh.ToString("N0")đ</div><small>Giá vốn hiện tại: @Model.GiaVon.ToString("N0")đ</small></div>
    <div class="stat-card" style="background:#0f766e"><div class="label">Giá trị đơn trung bình</div><div class="value">@Model.GiaTriDonTrungBinh.ToString("N0")đ</div><small>@Model.TongDonHuy đơn hủy (@Model.TyLeHuy.ToString("N1")%)</small></div>
</div>
<div class="card mb-3"><h3 style="margin-top:0">Doanh thu theo ngày</h3>
@if (Model.DoanhThuTheoNgay.Any()) { <canvas id="revenueChart" height="90"></canvas> } else { <div class="empty-state">Chưa có đơn hoàn thành trong khoảng đã chọn.</div> }
</div>
<div class="grid-2">
<div class="card"><h3 style="margin-top:0">Món bán chạy</h3><table class="data-table"><thead><tr><th>Món</th><th>SL</th><th>Doanh thu</th></tr></thead><tbody>
@foreach (var item in Model.MonBanChay) { <tr><td>@item.TenMon</td><td>@item.SoLuongBan</td><td>@item.DoanhThu.ToString("N0")đ</td></tr> }
</tbody></table></div>
<div class="card"><h3 style="margin-top:0">Đơn theo trạng thái</h3><table class="data-table"><thead><tr><th>Trạng thái</th><th>Số đơn</th></tr></thead><tbody>
@foreach (var item in Model.DonTheoTrangThai) { <tr><td>@item.TrangThai</td><td>@item.SoLuong</td></tr> }
</tbody></table></div>
</div>
@section Scripts {
@if (Model.DoanhThuTheoNgay.Any()) {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<script>new Chart(document.getElementById('revenueChart'),{type:'line',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels)),datasets:[{data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(values)),borderColor:'#8B5CF6',backgroundColor:'rgba(139,92,246,.1)',fill:true,tension:.3}]},options:{plugins:{legend:{display:false}},scales:{y:{beginAtZero:true}}}});</script>
}}
