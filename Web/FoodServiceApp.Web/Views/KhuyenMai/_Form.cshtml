@model KhuyenMaiFormViewModel

<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

<div class="form-group">
    <label asp-for="MaCode">Mã khuyến mãi</label>
    <input asp-for="MaCode" class="form-control" placeholder="vd: GIAM20" style="text-transform:uppercase;" />
    <span asp-validation-for="MaCode" class="field-validation-error"></span>
</div>

<div class="form-group">
    <label asp-for="MoTa">Mô tả</label>
    <textarea asp-for="MoTa" class="form-control" placeholder="vd: Giảm 20% cho đơn từ 50.000đ"></textarea>
</div>

<div class="grid-2">
    <div class="form-group">
        <label asp-for="LoaiGiam">Loại giảm</label>
        <select asp-for="LoaiGiam" class="form-control">
            <option value="PhanTram">Giảm theo %</option>
            <option value="SoTien">Giảm số tiền cố định</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="GiaTriGiam">Giá trị giảm</label>
        <input asp-for="GiaTriGiam" type="number" step="1" class="form-control" placeholder="vd: 20" />
    </div>
</div>

<div class="form-group">
    <label asp-for="DieuKienApDung">Điều kiện áp dụng</label>
    <input asp-for="DieuKienApDung" class="form-control" placeholder="vd: Đơn tối thiểu 50.000đ" />
</div>

<div class="grid-2">
    <div class="form-group">
        <label asp-for="NgayBatDau">Ngày bắt đầu</label>
        <input asp-for="NgayBatDau" type="date" class="form-control" />
        <span asp-validation-for="NgayBatDau" class="field-validation-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="NgayKetThuc">Ngày kết thúc</label>
        <input asp-for="NgayKetThuc" type="date" class="form-control" />
        <span asp-validation-for="NgayKetThuc" class="field-validation-error"></span>
    </div>
</div>

<div class="form-group">
    <label style="display:flex; align-items:center; gap:8px;">
        <input asp-for="TrangThai" type="checkbox" style="width:auto;" />
        Kích hoạt ngay
    </label>
</div>
