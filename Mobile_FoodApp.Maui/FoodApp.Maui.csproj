<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Chỉ build Windows khi chạy trên Windows (không cần Android SDK).
		     Muốn chạy Android: đổi dòng dưới thành net8.0-android;net8.0-windows10.0.19041.0
		     sau khi đã cài Android SDK + workload android. -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net8.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net8.0-android</TargetFrameworks>
		<UseRidGraph>true</UseRidGraph>

		<OutputType>Exe</OutputType>
		<RootNamespace>FoodApp.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<MauiVersion>8.0.100</MauiVersion>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Tên hiển thị của app -->
		<ApplicationTitle>FoodApp.Maui</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.doancuoiki.foodserviceapp</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
		<!-- Đóng gói Windows App Runtime cùng ứng dụng để chạy được cả trên máy chưa cài runtime.
		     WinUI cần app host .exe để khởi tạo Windows App SDK đúng cách. -->
		<RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('windows'))">win-x64</RuntimeIdentifier>
		<WindowsAppSDKSelfContained Condition="$([MSBuild]::IsOSPlatform('windows'))">true</WindowsAppSDKSelfContained>
		<SelfContained Condition="$([MSBuild]::IsOSPlatform('windows'))">true</SelfContained>
		<UseAppHost Condition="$([MSBuild]::IsOSPlatform('windows'))">true</UseAppHost>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Phát video intro khi khởi động -->
		<PackageReference Include="CommunityToolkit.Maui" Version="9.1.1" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="4.1.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#3C0293" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#3C0293" BaseSize="256,256" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts (thư mục để trống — app dùng font hệ thống mặc định) -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

</Project>
