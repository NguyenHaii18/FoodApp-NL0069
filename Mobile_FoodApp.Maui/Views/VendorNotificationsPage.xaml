<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodApp.Maui.Models"
             x:Class="FoodApp.Maui.Views.VendorNotificationsPage"
             Title="Thông báo">

    <Grid RowDefinitions="Auto,*" Padding="16">

        <Button Grid.Row="0" Text="Đánh dấu đã đọc tất cả" Style="{StaticResource OutlineButton}"
                Margin="0,0,0,12" Clicked="OnDocTatCaClicked" />

        <RefreshView Grid.Row="1" x:Name="RefreshDs" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="8">

                    <Label x:Name="LblRong" Text="Chưa có thông báo nào."
                           Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center"
                           Margin="0,30,0,0" IsVisible="False" />

                    <CollectionView x:Name="DsThongBao" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ThongBaoGianHang">
                                <Frame Style="{StaticResource CardFrame}" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding Icon}" FontSize="24" VerticalOptions="Start" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding TieuDe}" FontAttributes="Bold" FontSize="13.5" />
                                            <Label Text="{Binding NoiDung}" FontSize="12.5" TextColor="{StaticResource TextGrey}" />
                                            <Label Text="{Binding NgayText}" FontSize="11" TextColor="{StaticResource TextGrey}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding ChamChuaDoc}" TextColor="{StaticResource Danger}" FontSize="16" VerticalOptions="Start" />
                                    </Grid>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnThongBaoTapped" />
                                    </Frame.GestureRecognizers>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
