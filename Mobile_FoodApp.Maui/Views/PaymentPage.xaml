<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodApp.Maui.Models"
             x:Class="FoodApp.Maui.Views.PaymentPage"
             Title="Thanh toán">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="16">

                <Label Text="Địa chỉ giao hàng" FontAttributes="Bold" FontSize="13" />
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="6">
                        <Entry x:Name="EntryDiaChi" Placeholder="Nhập địa chỉ nhận món (ghi rõ quận/huyện để tính phí giao)" TextChanged="OnDiaChiChanged" />
                        <Label Text="🗺️ Tìm / chọn địa chỉ trên bản đồ" TextColor="{StaticResource Primary}" FontSize="12.5" FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChonBanDoTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="📒 Chọn từ sổ địa chỉ" TextColor="{StaticResource Primary}" FontSize="12.5" FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChonSoDiaChiTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Thời gian giao" FontAttributes="Bold" FontSize="13" />
                <Frame Style="{StaticResource CardFrame}">
                    <Picker x:Name="PickerGioGiao" Title="Chọn thời gian giao" />
                </Frame>

                <Label Text="Hình thức thanh toán" FontAttributes="Bold" FontSize="13" />
                <Frame Style="{StaticResource CardFrame}" Padding="0">
                    <VerticalStackLayout x:Name="DanhSachHinhThuc" />
                </Frame>

                <Label Text="Mã khuyến mãi (nếu có)" FontAttributes="Bold" FontSize="13" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Frame Grid.Column="0" Style="{StaticResource CardFrame}" Padding="0">
                        <Entry x:Name="EntryMaKhuyenMai" Placeholder="VD: GIAM10" />
                    </Frame>
                    <Button Grid.Column="1" Text="Áp dụng" Style="{StaticResource OutlineButton}"
                            Clicked="OnApDungKhuyenMaiClicked" />
                </Grid>
                <Label x:Name="LblKetQuaKhuyenMai" FontSize="12" IsVisible="False" />
                <Button Text="🎟️ Chọn ưu đãi" Style="{StaticResource OutlineButton}" HeightRequest="40" Clicked="OnChonUuDaiClicked" />

                <Label Text="Ghi chú cho gian hàng" FontAttributes="Bold" FontSize="13" />
                <Frame Style="{StaticResource CardFrame}">
                    <Editor x:Name="EditorGhiChu" HeightRequest="60"
                            Placeholder="VD: không lấy hành, giao giờ hành chính..." />
                </Frame>

                <Label Text="Chi tiết đơn hàng" FontAttributes="Bold" FontSize="13" />
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <CollectionView x:Name="DsChiTiet">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:MucGioHang">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,2">
                                        <Label Grid.Column="0" Text="{Binding SoLuong, StringFormat='{0}x'}" FontAttributes="Bold" FontSize="13" />
                                        <Label Grid.Column="1" Text="{Binding MonAn.TenMon}" FontSize="13" />
                                        <Label Grid.Column="2" Text="{Binding ThanhTien, StringFormat='{0:N0}đ'}" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Tạm tính" FontSize="12.5" />
                            <Label Grid.Column="1" x:Name="LblTamTinh" FontSize="12.5" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Phí giao hàng" FontSize="12.5" />
                            <Label Grid.Column="1" x:Name="LblPhiGiao" FontSize="12.5" Text="15.000đ" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" x:Name="RowGiamGia" IsVisible="False">
                            <Label Grid.Column="0" Text="Giảm giá" FontSize="12.5" TextColor="{StaticResource Success}" />
                            <Label Grid.Column="1" x:Name="LblGiamGia" FontSize="12.5" TextColor="{StaticResource Success}" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Tổng cộng" FontAttributes="Bold" FontSize="15" />
                            <Label Grid.Column="1" x:Name="LblTongCong" FontAttributes="Bold" FontSize="16"
                                   TextColor="{StaticResource Accent}" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="16">
            <ActivityIndicator x:Name="LoadingXacNhan" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}" />
            <Button x:Name="BtnXacNhanDatHang" Style="{StaticResource PrimaryButton}" Clicked="OnXacNhanDatHangClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
