<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodApp.Maui.Views.AdminLoginPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,40" Spacing="14">

            <Frame WidthRequest="72" HeightRequest="72" CornerRadius="18"
                   BackgroundColor="{StaticResource TextDark}"
                   HorizontalOptions="Center" Padding="0">
                <Label TextColor="White" Text="🛡️" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <Label Text="Cổng Quản Trị Hệ Thống" Style="{StaticResource TitleLabel}" HorizontalOptions="Center" />
            <Label Text="Đăng nhập để giám sát gian hàng, tài khoản và hoạt động kinh doanh"
                   Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center" Margin="0,0,0,10" />

            <Entry x:Name="EntryEmail" Placeholder="Email quản trị viên" Keyboard="Email" />
            <Entry x:Name="EntryMatKhau" Placeholder="Mật khẩu" IsPassword="True" />

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False"
                                Color="{StaticResource TextDark}" />

            <Button x:Name="BtnDangNhap" Text="Đăng nhập" Style="{StaticResource PrimaryButton}"
                    BackgroundColor="{StaticResource TextDark}" Clicked="OnDangNhapClicked" />

            <Label x:Name="LblLoi" TextColor="{StaticResource Danger}" FontSize="12"
                   HorizontalOptions="Center" IsVisible="False" />

            <Label Text="← Quay lại đăng nhập khách hàng" TextColor="{StaticResource TextGrey}"
                   FontSize="13" HorizontalOptions="Center" Margin="0,20,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQuayLaiTapped" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
