<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodApp.Maui.Models"
             x:Class="FoodApp.Maui.Views.VendorMenuPage"
             Title="Thực đơn">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16">

        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Quản lý danh mục" Style="{StaticResource OutlineButton}" Clicked="OnQuanLyDanhMucClicked" />
                <Button Grid.Column="1" Text="Sắp xếp danh mục" Style="{StaticResource OutlineButton}" Clicked="OnSapXepDanhMucClicked" />
            </Grid>
            <Button Text="+ Thêm món mới" Style="{StaticResource PrimaryButton}" Clicked="OnThemMonClicked" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,10"><HorizontalStackLayout x:Name="KhungDanhMuc" Spacing="8" /></ScrollView>

        <RefreshView Grid.Row="2" x:Name="RefreshThucDon" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="10">

                    <Label x:Name="LblRong" Text="Gian hàng chưa có món ăn nào. Bấm &quot;+ Thêm món mới&quot; để bắt đầu."
                           Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center"
                           Margin="0,30,0,0" IsVisible="False" />

                    <CollectionView x:Name="DsMonAn" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:MonAn">
                                <Frame Style="{StaticResource CardFrame}" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">

                                        <Frame Grid.Row="0" Grid.Column="0"
                                               WidthRequest="64" HeightRequest="64" CornerRadius="12" Padding="0"
                                               IsClippedToBounds="True" BackgroundColor="{StaticResource Background}">
                                            <Grid>
                                                <Image Source="{Binding AnhPath}" Aspect="AspectFill" IsVisible="{Binding CoAnh}" />
                                                <Label Text="{Binding HinhAnh}" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"
                                                       IsVisible="{Binding CoEmoji}" />
                                            </Grid>
                                        </Frame>

                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding TenMon}" FontAttributes="Bold" FontSize="14" />
                                            <Label FontSize="12" TextColor="{StaticResource TextGrey}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding DanhMuc}" />
                                                        <Span Text="  •  " />
                                                        <Span Text="{Binding Gia, StringFormat='{0:N0}đ'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Text="{Binding TinhTrangText}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                            <Label Text="{Binding MoTa}" FontSize="11.5" TextColor="{StaticResource TextGrey}" MaxLines="2" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding TomTatTuyChon}" FontSize="11" TextColor="{StaticResource Accent}" MaxLines="2" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                            <Button Grid.Column="0" Text="Sửa" Style="{StaticResource OutlineButton}"
                                                    HeightRequest="36" FontSize="12" Clicked="OnSuaClicked" CommandParameter="{Binding .}" />
                                            <Button Grid.Column="1" Text="Tình trạng" Style="{StaticResource OutlineButton}"
                                                    HeightRequest="36" FontSize="12" Clicked="OnDoiTinhTrangClicked" CommandParameter="{Binding .}" />
                                            <Button Grid.Column="2" Text="Xóa" HeightRequest="36" FontSize="12" CornerRadius="10"
                                                    BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
                                                    BorderColor="{StaticResource Danger}" BorderWidth="1"
                                                    Clicked="OnXoaClicked" CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
