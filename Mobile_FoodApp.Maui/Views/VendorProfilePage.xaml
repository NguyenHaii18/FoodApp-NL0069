<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodApp.Maui.Views.VendorProfilePage"
             Title="Hồ sơ cửa hàng">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Frame WidthRequest="72" HeightRequest="72" CornerRadius="18"
                   BackgroundColor="{StaticResource Primary}"
                   HorizontalOptions="Center" Padding="0">
                <Label TextColor="White" x:Name="LblAnhHienTai" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <Label Text="Ảnh cửa hàng" FontSize="13" FontAttributes="Bold" />
            <Frame Padding="0" CornerRadius="12" HeightRequest="150" HasShadow="False"
                   BackgroundColor="{StaticResource PrimarySoft}" IsClippedToBounds="True">
                <Grid>
                    <Image x:Name="ImgAnhCuaHang" Aspect="AspectFill" />
                    <Label x:Name="LblChuaCoAnh" Text="Chưa có ảnh" TextColor="{StaticResource TextGrey}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Frame>
            <Button Text="📷 Tải ảnh lên" Style="{StaticResource OutlineButton}" Clicked="OnTaiAnhClicked" />

            <Label Text="Biểu tượng cửa hàng (emoji, dùng khi chưa có ảnh)" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryHinhAnh" Placeholder="🍚" MaxLength="4" />

            <Label Text="Tên gian hàng *" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryTenGianHang" />

            <Label Text="Địa chỉ *" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryDiaChi" />

            <Label Text="Số điện thoại *" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntrySdt" Keyboard="Telephone" />

            <Label Text="Email" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryEmail" Keyboard="Email" IsEnabled="False" TextColor="{StaticResource TextGrey}" />

            <Label Text="Thời gian giao hàng dự kiến (phút)" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryThoiGianGiao" Keyboard="Numeric" />

            <Label Text="Giờ hoạt động" FontSize="13" FontAttributes="Bold" Margin="0,6,0,0" />
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                <TimePicker Grid.Column="0" x:Name="TimeMoCua" Format="HH:mm" />
                <Label Grid.Column="1" Text="đến" VerticalOptions="Center" TextColor="{StaticResource TextGrey}" />
                <TimePicker Grid.Column="2" x:Name="TimeDongCua" Format="HH:mm" />
            </Grid>
            <Label Text="Để 00:00 – 23:59 nếu quán hoạt động cả ngày. Ngoài giờ này khách không đặt được đơn mới." FontSize="11" TextColor="{StaticResource TextGrey}" />

            <Label Text="Giấy tờ pháp lý" FontSize="13" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="Quản trị viên có thể đối chiếu giấy tờ này bất cứ lúc nào." FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextGrey}, Dark={StaticResource TextGreyDark}}" />
            <Entry x:Name="EntryGpkd" Placeholder="Số giấy phép kinh doanh / ĐKKD" />
            <Entry x:Name="EntryMst" Placeholder="Mã số thuế (10 hoặc 13 chữ số)" Keyboard="Numeric" MaxLength="13" />
            <Entry x:Name="EntryAttp" Placeholder="Số giấy chứng nhận ATTP (An toàn thực phẩm)" />
            <Entry x:Name="EntryCccd" Placeholder="Số CCCD / CMND chủ quán" Keyboard="Numeric" MaxLength="12" />
            <Frame Padding="0" CornerRadius="12" HeightRequest="130" HasShadow="False" BackgroundColor="{StaticResource PrimarySoft}" IsClippedToBounds="True">
                <Grid>
                    <Image x:Name="ImgGiayPhep" Aspect="AspectFit" />
                    <Label x:Name="LblChuaCoGiayPhep" Text="Chưa có ảnh giấy phép" TextColor="{StaticResource TextGrey}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Frame>
            <Button Text="📷 Tải ảnh giấy phép kinh doanh" Style="{StaticResource OutlineButton}" Clicked="OnTaiGiayPhepClicked" />

            <Label Text="Mô tả cửa hàng" FontSize="13" FontAttributes="Bold" />
            <Editor x:Name="EditorMoTa" HeightRequest="90" BackgroundColor="White" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                <Label Grid.Column="0" Text="Đang mở bán" FontSize="13" VerticalOptions="Center" />
                <Switch Grid.Column="1" x:Name="SwitchDangMoCua" OnColor="{StaticResource Primary}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Đang nhận đơn mới" FontSize="13" />
                    <Label Text="Tắt khi quá tải: quán vẫn mở nhưng tạm dừng nhận đơn" FontSize="11" TextColor="{StaticResource TextGrey}" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" x:Name="SwitchDangNhanDon" OnColor="{StaticResource Primary}" VerticalOptions="Center" />
            </Grid>

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False"
                                Color="{StaticResource Primary}" />

            <Button x:Name="BtnLuu" Text="Lưu thay đổi" Style="{StaticResource PrimaryButton}"
                    Margin="0,10,0,0" Clicked="OnLuuClicked" />

            <Button Text="Đổi mật khẩu" Style="{StaticResource OutlineButton}" Clicked="OnDoiMatKhauClicked" />

            <Label x:Name="LblLoi" TextColor="{StaticResource Danger}" FontSize="12"
                   HorizontalOptions="Center" IsVisible="False" />

            <Label x:Name="LblThanhCong" TextColor="{StaticResource Success}" FontSize="12"
                   HorizontalOptions="Center" IsVisible="False" Text="✔ Đã lưu thay đổi" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
