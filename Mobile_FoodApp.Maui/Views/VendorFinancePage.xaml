<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodApp.Maui.Models"
             x:Class="FoodApp.Maui.Views.VendorFinancePage"
             Title="Tài chính">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" x:Name="BtnKyNgay" Text="Ngày" CornerRadius="16" HeightRequest="36" FontSize="13" Clicked="OnChonKyNgay" />
                <Button Grid.Column="1" x:Name="BtnKyThang" Text="Tháng" CornerRadius="16" HeightRequest="36" FontSize="13" Clicked="OnChonKyThang" />
                <Button Grid.Column="2" x:Name="BtnKyNam" Text="Năm" CornerRadius="16" HeightRequest="36" FontSize="13" Clicked="OnChonKyNam" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="◀" Style="{StaticResource OutlineButton}" WidthRequest="48" HeightRequest="38" Clicked="OnKyTruoc" />
                <Label Grid.Column="1" x:Name="LblNhanKy" FontAttributes="Bold" FontSize="15"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" x:Name="BtnKySau" Text="▶" Style="{StaticResource OutlineButton}" WidthRequest="48" HeightRequest="38" Clicked="OnKySau" />
            </Grid>

            <!-- Số tiền thực nhận -->
            <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="16" HasShadow="False">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Số tiền thực nhận" TextColor="#CCFFFFFF" FontSize="12" />
                    <Label x:Name="LblThucNhan" TextColor="White" FontAttributes="Bold" FontSize="26" />
                    <Label x:Name="LblSoDon" TextColor="#CCFFFFFF" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <!-- Đối soát -->
            <Label Text="Đối soát trong kỳ" Style="{StaticResource TitleLabel}" FontSize="16" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Tiền món (đơn hoàn thành)" FontSize="13" />
                        <Label Grid.Column="1" x:Name="LblDoanhThuMon" FontSize="13" FontAttributes="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Giảm giá do quán tài trợ" FontSize="13" />
                        <Label Grid.Column="1" x:Name="LblGiamGia" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" x:Name="LblNhanPhi" FontSize="13" />
                        <Label Grid.Column="1" x:Name="LblPhiNenTang" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Thực nhận" FontSize="14" FontAttributes="Bold" />
                        <Label Grid.Column="1" x:Name="LblThucNhanChiTiet" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Giá vốn các món đã bán" FontSize="13" TextColor="{StaticResource TextGrey}" />
                        <Label Grid.Column="1" x:Name="LblGiaVon" FontSize="13" TextColor="{StaticResource TextGrey}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Lợi nhuận ước tính" FontSize="14" FontAttributes="Bold" />
                        <Label Grid.Column="1" x:Name="LblLoiNhuan" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Label x:Name="LblGhiChu" FontSize="11.5" TextColor="{StaticResource TextGrey}" />

            <!-- Chi tiết từng đơn -->
            <Label Text="Chi tiết từng đơn" Style="{StaticResource TitleLabel}" FontSize="16" Margin="0,4,0,0" />
            <Label x:Name="LblRong" Text="Chưa có đơn hoàn thành trong kỳ này." Style="{StaticResource SubtitleLabel}"
                   HorizontalOptions="Center" Margin="0,10,0,0" IsVisible="False" />

            <CollectionView x:Name="DsDon" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DongDonTaiChinh">
                        <Frame Style="{StaticResource CardFrame}" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding TieuDe}" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="{Binding NgayText}" FontSize="11" TextColor="{StaticResource TextGrey}" />
                                    <Label Text="{Binding ChiTietText}" FontSize="11" TextColor="{StaticResource TextGrey}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding ThucNhanText}"
                                       FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Success}" VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
