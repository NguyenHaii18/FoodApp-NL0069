<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodApp.Maui.Models"
             x:Class="FoodApp.Maui.Views.TrangChuPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header xanh lá: vị trí, thông báo, icon tài khoản, ô tìm kiếm -->
        <Frame Grid.Row="0" BackgroundColor="{StaticResource Primary}" CornerRadius="0"
               Padding="18,14,18,18" HasShadow="False">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="📍" TextColor="White" />
                    <Label Grid.Column="1" x:Name="LblDiaChi" Text="Thêm địa chỉ giao hàng"
                           TextColor="White" FontSize="13" LineBreakMode="TailTruncation">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDiaChiTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="2" x:Name="LblChuong" Text="🔔" TextColor="White">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChuongTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="3" Text="👤" TextColor="White">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTaiKhoanTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <Label Text="Hôm nay bạn muốn ăn gì?" TextColor="White" FontSize="18" FontAttributes="Bold" />
                <Frame BackgroundColor="White" CornerRadius="10" Padding="12,10" HasShadow="False">
                    <Entry x:Name="EntryTimKiem" Placeholder="Tìm món ăn, quán ăn..." TextChanged="OnTimKiemChanged"
                           BackgroundColor="Transparent" />
                </Frame>
                <Label Text="🗺️ Tìm quán, địa điểm trên bản đồ" TextColor="White" FontSize="12.5" FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBanDoTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Frame>

        <!-- Danh sách gian hàng -->
        <CollectionView Grid.Row="1" x:Name="DsGianHang" Margin="16"
                         SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="6" Margin="0,50" HorizontalOptions="Center">
                    <Label Text="🏪" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="Chưa có quán nào" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="Các quán đối tác đã được duyệt sẽ hiện ở đây." Style="{StaticResource SubtitleLabel}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.Header>
                <VerticalStackLayout Spacing="8" Margin="0,0,0,8">
                    <CollectionView x:Name="DsDanhMuc" HeightRequest="42" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Text="{Binding .}" CommandParameter="{Binding .}" Clicked="OnDanhMucClicked"
                                        CornerRadius="18" HeightRequest="36" Padding="14,0" FontSize="13"
                                        BackgroundColor="{StaticResource PrimarySoft}" TextColor="{StaticResource Primary}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Ưu đãi hot: chạm để sao chép mã -->
                    <Grid ColumnDefinitions="*,Auto" x:Name="TieuDeUuDai">
                        <Label Text="🎟️ Ưu đãi hot" FontAttributes="Bold" FontSize="15" />
                        <Label Grid.Column="1" Text="Chạm để lấy mã" FontSize="11.5" TextColor="{StaticResource TextGrey}" VerticalOptions="Center" />
                    </Grid>
                    <CollectionView x:Name="DsUuDai" HeightRequest="104" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:KhuyenMai">
                                <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="16" Padding="14,10" WidthRequest="230"
                                       HasShadow="False" BorderColor="Transparent">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnUuDaiTapped" CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding GiaTriGiamHienThi}" TextColor="White" FontAttributes="Bold" FontSize="17" />
                                        <Label Text="{Binding TenChuongTrinh}" TextColor="#E6FFFFFF" FontSize="12" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding PhamViHienThi}" TextColor="#B3FFFFFF" FontSize="11" LineBreakMode="TailTruncation" />
                                        <Frame BackgroundColor="White" CornerRadius="10" Padding="8,2" HasShadow="False" HorizontalOptions="Start" BorderColor="Transparent">
                                            <Label Text="{Binding MaCode, StringFormat='Mã: {0}'}" TextColor="{StaticResource Primary}" FontAttributes="Bold" FontSize="11.5" />
                                        </Frame>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Tin mới -->
                    <Grid x:Name="TieuDeTin" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                        <Label Text="📰 Tin mới" FontAttributes="Bold" FontSize="15" />
                        <Label Grid.Column="1" Text="Xem tất cả ›" FontSize="12" TextColor="{StaticResource Primary}" FontAttributes="Bold" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnXemTatCaTinTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <CollectionView x:Name="DsTinMoi" HeightRequest="112" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TinTuc">
                                <Frame Style="{StaticResource CardFrame}" WidthRequest="220" Padding="12">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTinTapped" CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout Spacing="3">
                                        <Label FontSize="11" TextColor="{StaticResource Primary}" FontAttributes="Bold">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Icon}" />
                                                    <Span Text="  " />
                                                    <Span Text="{Binding NhanLoai}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding NgayHienThi}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Text="{Binding TieuDe}" FontAttributes="Bold" FontSize="13" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding TomTat}" FontSize="11.5" TextColor="{StaticResource TextGrey}" MaxLines="2" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label x:Name="LblGoiYTieuDe" Text="🔥 Gợi ý cho bạn" FontAttributes="Bold" FontSize="15" />
                    <CollectionView x:Name="DsGoiY" HeightRequest="128" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:MonAn">
                                <Frame Style="{StaticResource CardFrame}" WidthRequest="128" Padding="8">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnGoiYTapped" CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding HinhAnh}" FontSize="34" HorizontalOptions="Center" />
                                        <Label Text="{Binding TenMon}" FontAttributes="Bold" FontSize="12.5" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Gia, StringFormat='{0:N0}đ'}" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="🏪 Quán gần bạn" FontAttributes="Bold" FontSize="15" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:GianHang">
                    <Frame Style="{StaticResource CardFrame}" Margin="0,0,0,10" Padding="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGianHangTapped" CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="80,*" Padding="0">
                            <Frame Grid.Column="0" BackgroundColor="{StaticResource PrimarySoft}" CornerRadius="0"
                                   Padding="0" HasShadow="False">
                                <Grid>
                                    <Image Source="{Binding AnhPath}" Aspect="AspectFill" IsVisible="{Binding CoAnh}" />
                                    <Label Text="{Binding HinhAnh}" FontSize="34" IsVisible="{Binding CoEmoji}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Padding="12,10" Spacing="4">
                                <Label Text="{Binding TenGianHang}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding DiaChi}" Style="{StaticResource SubtitleLabel}" />
                                <Frame BackgroundColor="#FEF3C7" BorderColor="Transparent" CornerRadius="8" Padding="8,2" HasShadow="False"
                                       HorizontalOptions="Start" IsVisible="{Binding CoKhuyenMai}">
                                    <Label Text="{Binding NhanKhuyenMai}" FontSize="11.5" FontAttributes="Bold" TextColor="#B45309" />
                                </Frame>
                                <Label FontSize="12.5" TextColor="{StaticResource TextGrey}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="⭐ " />
                                            <Span Text="{Binding DanhGia}" />
                                            <Span Text="    ⏱ " />
                                            <Span Text="{Binding ThoiGianGiaoPhut}" />
                                            <Span Text=" phút" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
