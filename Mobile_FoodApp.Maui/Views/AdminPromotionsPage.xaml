<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodApp.Maui.Models"
             x:Class="FoodApp.Maui.Views.AdminPromotionsPage"
             Title="Khuyến mãi toàn hệ thống">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16">

        <Button Grid.Row="0" Text="+ Tạo khuyến mãi toàn hệ thống" Style="{StaticResource PrimaryButton}"
                BackgroundColor="{StaticResource TextDark}" Margin="0,0,0,10" Clicked="OnThemClicked" />

        <ScrollView Grid.Row="1" Orientation="Horizontal" Margin="-16,0,-16,10" Padding="16,0">
            <HorizontalStackLayout x:Name="KhungBoLoc" Spacing="8" />
        </ScrollView>

        <RefreshView Grid.Row="2" x:Name="RefreshDsKm" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="10">

                    <Label x:Name="LblRong" Text="Không có khuyến mãi nào ở phạm vi này."
                           Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center"
                           Margin="0,20,0,0" IsVisible="False" />

                    <CollectionView x:Name="DsKhuyenMai" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:KhuyenMai">
                                <Frame Style="{StaticResource CardFrame}" Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding MaCode}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource Primary}" />
                                            <Label Grid.Column="1" Text="{Binding TrangThaiHienThi}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextGrey}" />
                                        </Grid>
                                        <Label Text="{Binding TenChuongTrinh}" FontSize="13" FontAttributes="Bold" />
                                        <Label FontSize="11.5" TextColor="{StaticResource TextGrey}" Text="{Binding PhamViHienThi, StringFormat='Phạm vi: {0}'}" />
                                        <Label Text="{Binding GiaTriGiamHienThi}" FontSize="12.5" TextColor="{StaticResource Accent}" />
                                        <Label FontSize="11.5" TextColor="{StaticResource TextGrey}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Đã dùng " />
                                                    <Span Text="{Binding SoLuongDaDung}" />
                                                    <Span Text="/" />
                                                    <Span Text="{Binding SoLuongToiDaHienThi}" />
                                                    <Span Text=" lượt   •   Hết hạn " />
                                                    <Span Text="{Binding NgayKetThuc, StringFormat='{0:dd/MM/yyyy}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                            <Label Grid.Column="0" Text="Đang bật" FontSize="12" VerticalOptions="Center" />
                                            <Switch Grid.Column="1" HorizontalOptions="Start" IsToggled="{Binding DangHoatDong}"
                                                    Toggled="OnBatTatToggled" OnColor="{StaticResource TextDark}" />
                                            <Button Grid.Column="2" Text="Sửa" Clicked="OnSuaClicked" CommandParameter="{Binding .}" />
                                            <Button Grid.Column="3" Text="Ngừng" HeightRequest="34" FontSize="12" Padding="14,0" CornerRadius="10"
                                                    BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
                                                    BorderColor="{StaticResource Danger}" BorderWidth="1"
                                                    Clicked="OnXoaClicked" CommandParameter="{Binding .}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
