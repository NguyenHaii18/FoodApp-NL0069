<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodApp.Maui.Views.ProfilePage"
             Title="Tài khoản">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <!-- Thẻ đầu trang: avatar, tên, email, thống kê -->
            <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="20" HasShadow="False" Padding="18" BorderColor="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Frame WidthRequest="76" HeightRequest="76" CornerRadius="38" BackgroundColor="White" IsClippedToBounds="True"
                           HorizontalOptions="Center" Padding="0" HasShadow="False" BorderColor="Transparent">
                        <Frame.GestureRecognizers><TapGestureRecognizer Tapped="OnDoiAnhTapped" /></Frame.GestureRecognizers>
                        <Grid>
                            <Image x:Name="ImgAnh" Aspect="AspectFill" IsVisible="False" />
                            <Label x:Name="LblChuCai" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                    <Label Text="📷 Đổi ảnh đại diện" TextColor="White" FontSize="12" HorizontalOptions="Center">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnDoiAnhTapped" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="LblHoTen" FontAttributes="Bold" FontSize="17" TextColor="White" HorizontalOptions="Center" />
                    <Label x:Name="LblEmail" TextColor="#CCFFFFFF" FontSize="12.5" HorizontalOptions="Center" />
                    <Label x:Name="LblXacThuc" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnXacThucEmailTapped" /></Label.GestureRecognizers>
                    </Label>
                    <Grid ColumnDefinitions="*,*,*" Margin="0,6,0,0">
                        <VerticalStackLayout Grid.Column="0"><Label x:Name="LblSoDon" FontAttributes="Bold" FontSize="17" TextColor="White" HorizontalOptions="Center" /><Label Text="Đơn đã đặt" FontSize="11" TextColor="#CCFFFFFF" HorizontalOptions="Center" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"><Label x:Name="LblHoanThanh" FontAttributes="Bold" FontSize="17" TextColor="White" HorizontalOptions="Center" /><Label Text="Hoàn thành" FontSize="11" TextColor="#CCFFFFFF" HorizontalOptions="Center" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2"><Label x:Name="LblTongChi" FontAttributes="Bold" FontSize="17" TextColor="White" HorizontalOptions="Center" /><Label Text="Đã chi" FontSize="11" TextColor="#CCFFFFFF" HorizontalOptions="Center" /></VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Thông tin cá nhân (sửa được) -->
            <Label Text="Thông tin cá nhân" FontAttributes="Bold" FontSize="13" Margin="0,6,0,0" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Họ và tên" Style="{StaticResource SubtitleLabel}" />
                    <Entry x:Name="EntryHoTen" Placeholder="Họ và tên" />
                    <Label Text="Email (đổi email cần xác thực OTP)" Style="{StaticResource SubtitleLabel}" />
                    <Entry x:Name="EntryEmail" Placeholder="Email" Keyboard="Email" />
                    <Label Text="Số điện thoại" Style="{StaticResource SubtitleLabel}" />
                    <Entry x:Name="EntrySdt" Placeholder="Số điện thoại" Keyboard="Telephone" />
                    <Label Text="Địa chỉ giao hàng" Style="{StaticResource SubtitleLabel}" />
                    <Entry x:Name="EntryDiaChi" Placeholder="Số nhà, đường, quận..." />
                    <Label x:Name="LblLoiHoSo" TextColor="{StaticResource Danger}" FontSize="12" IsVisible="False" />
                    <Button x:Name="BtnLuuHoSo" Text="Lưu thông tin" Style="{StaticResource PrimaryButton}" Clicked="OnLuuHoSoClicked" />
                </VerticalStackLayout>
            </Frame>

            <!-- Phương thức thanh toán mặc định -->
            <Label Text="Thanh toán mặc định" FontAttributes="Bold" FontSize="13" Margin="0,6,0,0" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <Button x:Name="BtnTienMat" Grid.Column="0" Text="💵 Tiền mặt" CommandParameter="TienMat" Clicked="OnThanhToanClicked" CornerRadius="18" FontSize="12.5" />
                <Button x:Name="BtnChuyenKhoan" Grid.Column="1" Text="🏦 Chuyển khoản" CommandParameter="ChuyenKhoan" Clicked="OnThanhToanClicked" CornerRadius="18" FontSize="12.5" />
                <Button x:Name="BtnViDienTu" Grid.Column="2" Text="📱 Ví điện tử" CommandParameter="ViDienTu" Clicked="OnThanhToanClicked" CornerRadius="18" FontSize="12.5" />
            </Grid>

            <!-- Ưu đãi đang có -->
            <Label Text="Ưu đãi của tôi" FontAttributes="Bold" FontSize="13" Margin="0,6,0,0" />
            <VerticalStackLayout x:Name="KhungUuDai" Spacing="8" />
            <Label x:Name="LblKhongUuDai" Text="Hiện chưa có ưu đãi nào" Style="{StaticResource SubtitleLabel}" IsVisible="False" />

            <Label Text="Tiện ích" FontAttributes="Bold" FontSize="13" Margin="0,6,0,0" />
            <Frame Style="{StaticResource CardFrame}" Padding="14,4">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,10"><Label Text="📒  Sổ địa chỉ" FontSize="13.5" /><Label Grid.Column="1" Text="›" FontSize="18" TextColor="{StaticResource TextGrey}" /><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnSoDiaChiTapped" /></Grid.GestureRecognizers></Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,10"><Label Text="❤️  Quán yêu thích" FontSize="13.5" /><Label Grid.Column="1" Text="›" FontSize="18" TextColor="{StaticResource TextGrey}" /><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnYeuThichTapped" /></Grid.GestureRecognizers></Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,10"><Label Text="📰  Tin mới &amp; thông báo" FontSize="13.5" /><Label Grid.Column="1" Text="›" FontSize="18" TextColor="{StaticResource TextGrey}" /><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnTinMoiTapped" /></Grid.GestureRecognizers></Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,10"><Label Text="🎁  Giới thiệu bạn bè" FontSize="13.5" /><Label Grid.Column="1" Text="›" FontSize="18" TextColor="{StaticResource TextGrey}" /><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnGioiThieuTapped" /></Grid.GestureRecognizers></Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,10"><Label Text="💬  Trợ giúp &amp; gửi phản hồi" FontSize="13.5" /><Label Grid.Column="1" Text="›" FontSize="18" TextColor="{StaticResource TextGrey}" /><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnPhanHoiTapped" /></Grid.GestureRecognizers></Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,10"><Label Text="ℹ️  Về ứng dụng" FontSize="13.5" /><Label Grid.Column="1" Text="›" FontSize="18" TextColor="{StaticResource TextGrey}" /><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnVeUngDungTapped" /></Grid.GestureRecognizers></Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <Frame.GestureRecognizers><TapGestureRecognizer Tapped="OnCaiDatTapped" /></Frame.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="⚙️  Cài đặt" FontSize="13.5" />
                        <Label Text="Giao diện, màu chủ đề, thông báo, máy chủ, dữ liệu" FontSize="11" TextColor="{StaticResource TextGrey}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="18" TextColor="{StaticResource TextGrey}" />
                </Grid>
            </Frame>
            <Frame Style="{StaticResource CardFrame}">
                <Frame.GestureRecognizers><TapGestureRecognizer Tapped="OnLichSuDangNhapTapped" /></Frame.GestureRecognizers>
                <Label Text="🕘  Lịch sử đăng nhập" FontSize="13" />
            </Frame>
            <Frame Style="{StaticResource CardFrame}">
                <Frame.GestureRecognizers><TapGestureRecognizer Tapped="OnDoiMatKhauTapped" /></Frame.GestureRecognizers>
                <Label Text="🔑  Đổi mật khẩu" FontSize="13" />
            </Frame>
            <Frame Style="{StaticResource CardFrame}">
                <Frame.GestureRecognizers><TapGestureRecognizer Tapped="OnXoaTaiKhoanTapped" /></Frame.GestureRecognizers>
                <Label Text="🗑️  Xóa tài khoản" FontSize="13" TextColor="{StaticResource TextGrey}" />
            </Frame>
            <Frame Style="{StaticResource CardFrame}" BorderColor="{StaticResource Danger}">
                <Frame.GestureRecognizers><TapGestureRecognizer Tapped="OnDangXuatTapped" /></Frame.GestureRecognizers>
                <Label Text="🚪  Đăng xuất" FontSize="13" TextColor="{StaticResource Danger}" />
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
