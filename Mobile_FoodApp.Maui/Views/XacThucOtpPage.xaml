<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodApp.Maui.Views.XacThucOtpPage"
             Title="Xác thực OTP">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="🔐" FontSize="44" HorizontalOptions="Center" Margin="0,10,0,0" />
            <Label x:Name="LblTieuDe" Style="{StaticResource TitleLabel}" HorizontalOptions="Center" />
            <Label x:Name="LblHuongDan" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextGrey}, Dark={StaticResource TextGreyDark}}" HorizontalTextAlignment="Center" />

            <Frame x:Name="KhungMaDemo" IsVisible="False" Style="{StaticResource CardFrame}" BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource BorderColorDark}}">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="LblGhiChuDemo" FontSize="11.5" TextColor="{AppThemeBinding Light={StaticResource TextGrey}, Dark={StaticResource TextGreyDark}}" />
                    <Label x:Name="LblMaDemo" FontSize="26" FontAttributes="Bold" CharacterSpacing="6" HorizontalOptions="Center" TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Frame>

            <Entry x:Name="EntryOtp" Placeholder="Nhập mã 6 số" Keyboard="Numeric" MaxLength="6" HorizontalTextAlignment="Center" FontSize="20" />
            <Label x:Name="LblLoi" TextColor="{StaticResource Danger}" FontSize="12.5" IsVisible="False" HorizontalTextAlignment="Center" />
            <ActivityIndicator x:Name="Dang" IsRunning="False" IsVisible="False" />

            <Button x:Name="BtnXacNhan" Text="Xác nhận" Style="{StaticResource PrimaryButton}" Clicked="OnXacNhanClicked" />
            <Button x:Name="BtnGuiLai" Text="Gửi lại mã" Style="{StaticResource OutlineButton}" Clicked="OnGuiLaiClicked" />
            <Label Text="Để sau" TextColor="{AppThemeBinding Light={StaticResource TextGrey}, Dark={StaticResource TextGreyDark}}" FontSize="13" HorizontalOptions="Center" Margin="0,6,0,0">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBoQuaTapped" /></Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
