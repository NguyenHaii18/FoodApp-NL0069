<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodApp.Maui.Views.DiaChiPage"
             Title="Sổ địa chỉ">
    <Grid RowDefinitions="*,Auto" Padding="16" RowSpacing="10">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout x:Name="DanhSach" Spacing="10" />
        </ScrollView>
        <Button Grid.Row="1" Text="+ Thêm địa chỉ mới" Style="{StaticResource PrimaryButton}" Clicked="OnThemClicked" />
    </Grid>
</ContentPage>
