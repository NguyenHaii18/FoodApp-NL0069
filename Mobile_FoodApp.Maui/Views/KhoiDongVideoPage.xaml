<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodApp.Maui.Views.KhoiDongVideoPage"
             BackgroundColor="#3C0293"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid x:Name="IntroGrid">
        <!-- Windows thêm màn hình dự phòng này vì MediaElement có thể không có
             Windows.System.Display.DisplayRequest trên một số máy. -->
        <VerticalStackLayout HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="18">
            <Label Text="FoodApp"
                   FontSize="44"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />
            <ActivityIndicator IsRunning="True" Color="White" />
        </VerticalStackLayout>

        <Button x:Name="BtnBoQua"
                Text="Bỏ qua ▶"
                HorizontalOptions="End" VerticalOptions="Start"
                Margin="0,40,20,0" Padding="18,6" CornerRadius="18"
                BackgroundColor="#E6FFFFFF" TextColor="#3C0293" FontAttributes="Bold"
                Clicked="BoQua_Clicked" />
    </Grid>
</ContentPage>
