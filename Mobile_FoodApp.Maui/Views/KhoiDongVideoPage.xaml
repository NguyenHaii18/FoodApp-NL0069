<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FoodApp.Maui.Views.KhoiDongVideoPage"
             BackgroundColor="#3C0293"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid>
        <!-- Video intro (Resources/Raw/intro.mp4), phát tự động, không tiếng, không hiện nút điều khiển -->
        <toolkit:MediaElement x:Name="Video"
                              ShouldAutoPlay="True"
                              ShouldShowPlaybackControls="False"
                              ShouldMute="True"
                              Aspect="AspectFit"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill"
                              MediaEnded="Video_MediaEnded"
                              MediaFailed="Video_MediaFailed" />

        <Button x:Name="BtnBoQua"
                Text="Bỏ qua ▶"
                HorizontalOptions="End" VerticalOptions="Start"
                Margin="0,40,20,0" Padding="18,6" CornerRadius="18"
                BackgroundColor="#E6FFFFFF" TextColor="#3C0293" FontAttributes="Bold"
                Clicked="BoQua_Clicked" />
    </Grid>
</ContentPage>
