<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodApp.Maui.Views.TinTucPage"
             Title="Tin mới">
    <Grid RowDefinitions="Auto,*" Padding="16,12,16,0" RowSpacing="10">
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="ThanhLoc" Spacing="8" />
        </ScrollView>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="DanhSach" Spacing="10" Padding="0,0,0,16" />
        </ScrollView>
    </Grid>
</ContentPage>
